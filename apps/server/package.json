{
  "name": "@patchy/server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --conditions=development watch src/start.ts",
    "start": "node dist/start.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker": "docker build -f Dockerfile -t patchy-server ../.."
  },
  "dependencies": {
    "@patchy/config": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/db": "workspace:*",
    "@patchy/storage": "workspace:*",
    "fastify": "^5.5.0",
    "posthog-node": "^5.48.2"
  }
}
