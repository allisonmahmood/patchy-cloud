{
  "name": "@patchy/server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./migrations": {
      "development": "./src/migrations.ts",
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --conditions=development watch src/start.ts",
    "start": "node dist/start.js",
    "exec": "node dist/exec.js",
    "fleet": "node dist/fleet.js",
    "test": "vitest run",
    "docker": "docker build -f Dockerfile -t patchy-server ../.."
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@patchy/analytics": "workspace:*",
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/companies": "workspace:*",
    "@patchy/company-database": "workspace:*",
    "@patchy/content-store": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/execution": "workspace:*",
    "@patchy/integrations": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/patches": "workspace:*",
    "@patchy/portal": "workspace:*",
    "@patchy/primitives": "workspace:*",
    "@patchy/runtime": "workspace:*",
    "@patchy/sdk": "workspace:*",
    "@patchy/serving": "workspace:*",
    "@patchy/sql": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "^5.0.3"
  }
}
