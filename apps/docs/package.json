{
  "name": "@patchy/docs",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The public docs site: Fumadocs on Next.js, with the Limits page rendered from the limits registry at build time.",
  "scripts": {
    "generate": "node --import tsx --conditions=development scripts/generate.ts",
    "dev": "pnpm run generate && next dev --port 4477",
    "build": "pnpm run generate && next build",
    "start": "next start --port 4477",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@patchy/limits": "workspace:*",
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vercel": "66.2.0"
  }
}
