{
  "name": "patchy-cloud",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": "11.28.3"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "node --import tsx --conditions=development scripts/dev/src/main.ts",
    "prototype:updates:seed": "node packages/portal/prototypes/updates/seed-app.mjs",
    "prototype:updates": "node --import tsx packages/portal/prototypes/updates/server.mjs",
    "patchy": "node --import tsx --conditions=development packages/patchy/src/index.ts",
    "seed:dev": "node scripts/seed-dev.mjs",
    "test": "vitest run",
    "test:clerk": "node --import tsx --conditions=development scripts/test-clerk.ts",
    "test:content-store:live": "vitest run --config vitest.content-store-live.config.ts",
    "test:browser": "playwright test -c playwright.tier1.config.ts --project=chromium",
    "check": "node --import tsx scripts/verify.ts check",
    "verify": "node --import tsx scripts/verify.ts verify",
    "test:packed-cli-e2e": "node scripts/packed-cli-e2e.mjs",
    "test:packed-preact-e2e": "node scripts/packed-preact-e2e.mjs",
    "test:packed-tier2-e2e": "node scripts/packed-cli-e2e.mjs --tier2",
    "test:postgres-concurrency": "vitest run --config vitest.postgres.config.ts",
    "prepare": "node scripts/build-serving-broker.mjs && effect-language-service patch && simple-git-hooks",
    "lint": "eslint --cache \"**/*.{ts,mts,cts,tsx}\"",
    "typecheck": "node scripts/build-serving-broker.mjs && effect-language-service patch && turbo run typecheck typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache ."
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint/js": "^10.0.1",
    "@patchy/auth": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "effect": "catalog:",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "lint-staged": "^17.6.0",
    "npm": "12.2.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "rollup": "^4.63.6",
    "rollup-plugin-dts": "^6.3.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --cache --ignore-unknown"
  }
}
