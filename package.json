{
  "name": "patchy-cloud",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": "11.5.2"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "node --import tsx --conditions=development scripts/dev/src/main.ts",
    "patchy": "node --import tsx --conditions=development packages/cli/src/index.ts",
    "seed:dev": "node scripts/seed-dev.mjs",
    "test": "vitest run",
    "test:clerk": "node --import tsx --conditions=development scripts/test-clerk.ts",
    "test:all": "sh scripts/test-all.sh",
    "test:packed-cli-e2e": "node scripts/packed-cli-e2e.mjs",
    "prepare": "effect-language-service patch && simple-git-hooks",
    "lint": "eslint \"**/*.{ts,mts,cts,tsx}\"",
    "typecheck": "effect-language-service patch && turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint/js": "^10.0.1",
    "@patchy/auth": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "effect": "catalog:",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "lint-staged": "^17.4.1",
    "npm": "12.0.2",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
