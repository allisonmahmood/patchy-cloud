{
  "name": "patchy-cloud",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": "12.9.1"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --conditions=development scripts/dev/src/main.ts",
    "patchy": "node --import tsx --conditions=development packages/patchy/src/index.ts",
    "seed:dev": "bun scripts/seed-dev.mjs",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run --config vitest.bun.config.ts",
    "test:clerk": "bun --conditions=development scripts/test-clerk.ts",
    "test:content-store:live": "vitest run --config vitest.content-store-live.config.ts",
    "test:pidgeon": "vitest run --config vitest.pidgeon-live.config.ts",
    "test:pidgeon:sweep": "bun --conditions=development packages/integrations/live/sweep.ts",
    "test:attio": "vitest run --config vitest.attio-live.config.ts",
    "test:browser": "playwright test -c playwright.tier1.config.ts --project=chromium",
    "check": "bun scripts/verify.ts check",
    "verify": "bun scripts/verify.ts verify",
    "test:packed-cli-e2e": "node scripts/packed-cli-e2e.mjs",
    "test:packed-install-e2e": "node scripts/packed-install-e2e.mjs",
    "test:packed-preact-e2e": "node scripts/packed-preact-e2e.mjs",
    "test:packed-tier2-e2e": "node scripts/packed-cli-e2e.mjs --tier2",
    "test:postgres-concurrency": "vitest run --config vitest.postgres.config.ts",
    "test:rollback-rehearsal": "node --import tsx --conditions=development scripts/rollback-rehearsal.ts",
    "prepare": "node scripts/build-serving-broker.mjs && simple-git-hooks",
    "lint": "oxlint",
    "typecheck": "node scripts/build-serving-broker.mjs && turbo run typecheck typecheck:tests",
    "typecheck:tests": "effect-tsgo tsc -p tsconfig.test.json",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "devDependencies": {
    "@babel/parser": "8.0.8",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.90.0",
    "@patchy/auth": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "bun": "runtime:1.4.4",
    "effect": "catalog:",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "lint-staged": "^17.6.0",
    "minimatch": "^10.2.6",
    "npm": "12.2.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "^8.23.1",
    "rolldown": "1.2.15",
    "rolldown-plugin-dts": "0.28.8",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "bun fmt --ignore-unknown"
  }
}
