{
  "name": "patchy-cloud",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": "11.5.2"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "seed:dev": "node scripts/seed-dev.mjs",
    "test": "vitest run",
    "test:packed-cli-e2e": "node scripts/packed-cli-e2e.mjs",
    "test:docker-save": "node scripts/validate-docker-save-artifact.test.mjs",
    "test:server-image": "bash scripts/verify-server-image.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate",
    "docker": "turbo run docker",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "npm": "12.0.2",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
