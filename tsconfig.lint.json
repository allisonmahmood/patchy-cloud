{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@patchy/api": ["./packages/api/src/index.ts"],
      "@patchy/config": ["./packages/config/src/index.ts"],
      "@patchy/core": ["./packages/core/src/index.ts"],
      "@patchy/db": ["./packages/db/src/index.ts"],
      "@patchy/storage": ["./packages/storage/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
