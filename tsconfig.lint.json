{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@patchy/analytics": ["./packages/analytics/src/index.ts"],
      "@patchy/api": ["./packages/api/src/index.ts"],
      "@patchy/auth": ["./packages/auth/src/index.ts"],
      "@patchy/core": ["./packages/core/src/index.ts"],
      "@patchy/limits": ["./packages/limits/src/index.ts"],
      "@patchy/patches": ["./packages/patches/src/index.ts"],
      "@patchy/serving": ["./packages/serving/src/index.ts"],
      "@patchy/sql": ["./packages/sql/src/index.ts"],
      "@patchy/sql/testing": ["./packages/sql/src/testing.ts"],
      "@patchy/content-store": ["./packages/content-store/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx"],
  "exclude": ["**/dist/**", "**/node_modules/**", ".claude/**"]
}
