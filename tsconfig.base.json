{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "plugins": [
      {
        // `effect-tsgo patch` (run by `prepare` and `typecheck`) installs the
        // native compiler with Effect diagnostics. It retains this plugin name.
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          // Namespace imports are enforced by ESLint's namespace-service-imports rule.
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "instanceOfSchema": "error",
          "deterministicKeys": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "preferSchemaOverJson": "error",
          "globalConsoleInEffect": "error",
          "globalDateInEffect": "error",
          "globalRandomInEffect": "error",
          "globalTimersInEffect": "error",
          "globalFetchInEffect": "error",
          "cryptoRandomUUIDInEffect": "error",
          // Whole-file variants of the rules above. A Node API with no Effect
          // equivalent is allowed per file with `// @effect-diagnostics <rule>:off`.
          "nodeBuiltinImport": "error",
          "globalConsole": "error",
          "globalDate": "error",
          "globalRandom": "error",
          "globalTimers": "error",
          "globalFetch": "error",
          "cryptoRandomUUID": "error"
        }
      }
    ]
  }
}
