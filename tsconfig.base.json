{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "plugins": [
      {
        // Effect diagnostics. Scripts compile with `effect-tsgo tsc`, TypeScript 7
        // with the Effect checker (@effect/tsgo) built in, so these fail the build.
        // Suggestions stay in the editor; ESLint-era namespace imports are lint's
        // patchy/namespace-service-imports.
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "diagnosticSeverity": {
          // The server and CLI use effect/http and effect/sql, @stability unstable, on purpose.
          "unstableApiUsage": "off",
          // A warning new in @effect/tsgo, off until #1002 works through its findings.
          "schemaClassObjectLiteral": "off",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "instanceOfSchema": "error",
          "deterministicKeys": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "preferSchemaOverJson": "error",
          "globalConsoleInEffect": "error",
          "globalDateInEffect": "error",
          "globalRandomInEffect": "error",
          "globalTimersInEffect": "error",
          "globalFetchInEffect": "error",
          "cryptoRandomUUIDInEffect": "error",
          // Whole-file variants of the rules above. A Node API with no Effect
          // equivalent is allowed per file with `// @effect-diagnostics <rule>:off`.
          "nodeBuiltinImport": "error",
          "globalConsole": "error",
          "globalDate": "error",
          "globalRandom": "error",
          "globalTimers": "error",
          "globalFetch": "error",
          "cryptoRandomUUID": "error"
        }
      }
    ]
  }
}
