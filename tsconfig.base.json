{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "plugins": [
      {
        // Effect diagnostics. `effect-language-service patch` (run by `prepare`
        // and `typecheck`) bakes the plugin into tsc so these fail the build.
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "importFromBarrel": "error",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "instanceOfSchema": "error",
          "deterministicKeys": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "preferSchemaOverJson": "error",
          "globalConsoleInEffect": "error",
          "globalDateInEffect": "error",
          "globalRandomInEffect": "error",
          "globalTimersInEffect": "error",
          "globalFetchInEffect": "error",
          "cryptoRandomUUIDInEffect": "error",
          // Whole-file variants of the rules above. Errors everywhere the port
          // has reached; packages/cli/tsconfig.json keeps them warnings until
          // the CLI ports (#78). A Node API with no Effect equivalent is
          // allowed per file with `// @effect-diagnostics <rule>:off`.
          "nodeBuiltinImport": "error",
          "globalConsole": "error",
          "globalDate": "error",
          "globalRandom": "error",
          "globalTimers": "error",
          "globalFetch": "error",
          "cryptoRandomUUID": "error"
          // Omitted as v3-only in @effect/language-service 0.87.2, so inert on
          // Effect 4: missingEffectServiceDependency, schemaSyncInEffect,
          // nonObjectEffectServiceType, scopeInLayerEffect, schemaUnionOfLiterals.
        }
      }
    ]
  }
}
