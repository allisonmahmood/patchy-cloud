{
  "name": "@patchy/patches",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The patches capability: user-owned records and versions, publishing, lifecycle moves and actor stamps, visits, the patch quota, the deletion sweep, migrations, and the patches HttpApi group.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@patchy/analytics": "workspace:*",
    "@patchy/api": "workspace:*",
    "@patchy/company-database": "workspace:*",
    "@patchy/content-store": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/integrations": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/primitives": "workspace:*",
    "@patchy/runtime": "workspace:*",
    "@patchy/sql": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@patchy/auth": "workspace:*",
    "vitest": "^4.1.11"
  }
}
