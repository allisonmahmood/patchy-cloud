{
  "name": "@patchy/serving",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The serving capability: the serving guarantees every published patch is delivered under, the page routes (home, health, the patch at its latest and version URLs), and the trusted-proxy schema that decides where a request came from.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell": {
      "development": "./src/shell.ts",
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-serving-broker.mjs && tsc -p tsconfig.json",
    "test": "node ../../scripts/build-serving-broker.mjs && vitest run",
    "typecheck": "node ../../scripts/build-serving-broker.mjs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/companies": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/patches": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@patchy/analytics": "workspace:*",
    "@patchy/company-database": "workspace:*",
    "@patchy/content-store": "workspace:*",
    "@patchy/integrations": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/primitives": "workspace:*",
    "@patchy/sql": "workspace:*",
    "vitest": "^4.1.11"
  }
}
