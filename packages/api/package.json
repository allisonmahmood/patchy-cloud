{
  "name": "@patchy/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The Patchy Cloud wire contract: one schema per wire shape, the HttpApi, the derived client.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guest": {
      "development": "./src/guest.ts",
      "types": "./dist/guest.d.ts",
      "import": "./dist/guest.js"
    },
    "./management": {
      "development": "./src/management.ts",
      "types": "./dist/management.d.ts",
      "import": "./dist/management.js"
    },
    "./handlers": {
      "development": "./src/handlers.ts",
      "types": "./dist/handlers.d.ts",
      "import": "./dist/handlers.js"
    },
    "./canonical-args": {
      "development": "./src/canonicalArgs.ts",
      "types": "./dist/canonicalArgs.d.ts",
      "import": "./dist/canonicalArgs.js"
    },
    "./query-config": {
      "development": "./src/queryConfig.ts",
      "types": "./dist/queryConfig.d.ts",
      "import": "./dist/queryConfig.js"
    },
    "./postgres-snapshot": {
      "development": "./src/postgresSnapshot.ts",
      "types": "./dist/postgresSnapshot.d.ts",
      "import": "./dist/postgresSnapshot.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "render-docs": "node --import tsx --conditions=development scripts/render-api-md.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@patchy/limits": "workspace:*",
    "effect": "catalog:"
  }
}
