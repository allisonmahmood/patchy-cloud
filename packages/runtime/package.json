{
  "name": "@patchy/runtime",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Browser runtime admission, request binding, operation dispatch and the attributed runtime log.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "development": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./executor": {
      "development": "./src/Executor.ts",
      "types": "./dist/Executor.d.ts",
      "import": "./dist/Executor.js"
    },
    "./execution-lifecycle": {
      "development": "./src/ExecutionLifecycle.ts",
      "types": "./dist/ExecutionLifecycle.d.ts",
      "import": "./dist/ExecutionLifecycle.js"
    },
    "./dev": {
      "development": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@patchy/analytics": "workspace:*",
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/sql": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@patchy/companies": "workspace:*",
    "vitest": "^5.0.3"
  }
}
