{
  "name": "@patchy/sdk",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Managed project generation, skills and immutable SDK release artifacts.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "artifacts",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-sdk-artifact.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@patchy/api": "workspace:*",
    "@patchy/company-database": "workspace:*",
    "@patchy/content-store": "workspace:*",
    "@patchy/integrations": "workspace:*",
    "@patchy/patches": "workspace:*",
    "effect": "catalog:",
    "patchy": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "^5.0.1"
  }
}
