{
  "name": "@patchy/analytics",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Business analytics and unsampled, Effect-scoped wide events, with stdout and a shared optional PostHog client.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wide-events": {
      "development": "./src/WideEvents.ts",
      "types": "./dist/WideEvents.d.ts",
      "import": "./dist/WideEvents.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "catalog:",
    "posthog-node": "^5.52.5"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "^5.0.1"
  }
}
