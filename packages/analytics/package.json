{
  "name": "@patchy/analytics",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The analytics event service the emitters report through: a PostHog layer whose finalizer flushes under 3 s, and a no-op layer for tests and unconfigured instances.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "catalog:",
    "posthog-node": "^5.51.4"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "^4.1.11"
  }
}
