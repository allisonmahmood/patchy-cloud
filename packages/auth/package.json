{
  "name": "@patchy/auth",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Clerk browser sessions, user-owned machine tokens, bearer authentication, auth pages, migrations, and the development seed.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seed": {
      "development": "./src/seed.ts",
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "3.17.0",
    "@patchy/analytics": "workspace:*",
    "@patchy/api": "workspace:*",
    "@patchy/companies": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/sql": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "tough-cookie": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
