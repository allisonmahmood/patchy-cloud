{
  "name": "@patchy/auth",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The auth capability: tokens and principals, self-service minting with its quota, revocation, bearer parsing, the accounts/api_tokens/token_mints migrations, and the auth HttpApi group.",
