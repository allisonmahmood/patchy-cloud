{
  "name": "patchy-activepieces-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "node --import tsx --conditions=development local.mjs",
    "local:slack": "node --import tsx --conditions=development local.mjs --slack",
    "local:status": "node --import tsx --conditions=development ../../../scripts/dev/src/main.ts status",
    "local:logs": "node --import tsx --conditions=development ../../../scripts/dev/src/main.ts logs",
    "local:stop": "node --import tsx --conditions=development ../../../scripts/dev/src/main.ts stop",
    "demo": "../../../node_modules/.bin/vitest run --config vitest.config.ts",
    "typecheck": "../../../node_modules/.bin/tsc -p tsconfig.json"
  },
  "dependencies": {
    "@activepieces/piece-posthog": "0.7.1",
    "@activepieces/piece-slack": "0.23.1"
  }
}
