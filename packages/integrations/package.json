{
  "name": "@patchy/integrations",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Company connections, encrypted credentials and Postgres schema discovery.",
  "exports": {
    "./models-fake": {
      "development": "./src/models/Fake.ts",
      "types": "./dist/models/Fake.d.ts",
      "import": "./dist/models/Fake.js"
    },
    "./dev": {
      "development": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "effect-tsgo tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/ai-openai": "catalog:",
    "@electric-sql/pglite": "0.5.17",
    "@patchy/analytics": "workspace:*",
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/companies": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/runtime": "workspace:*",
    "effect": "catalog:",
    "imapflow": "2.11.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@patchy/sql": "workspace:*",
    "@types/pg": "^8.23.1",
    "vitest": "^5.1.1"
  }
}
