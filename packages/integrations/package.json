{
  "name": "@patchy/integrations",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Company connections, encrypted credentials and Postgres schema discovery.",
  "exports": {
    "./dev": {
      "development": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.definition.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/companies": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/runtime": "workspace:*",
    "effect": "catalog:",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@patchy/sql": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
