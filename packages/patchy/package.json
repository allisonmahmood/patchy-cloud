{
  "name": "patchy",
  "version": "0.31.0",
  "description": "The Patchy CLI, typed config, browser client and local dev runtime.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Allison Mahmood",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allisonmahmood/patchy-cloud.git",
    "directory": "packages/patchy"
  },
  "homepage": "https://github.com/allisonmahmood/patchy-cloud#readme",
  "bugs": "https://github.com/allisonmahmood/patchy-cloud/issues",
  "keywords": [
    "html",
    "static-html",
    "patches",
    "preview",
    "publish",
    "cli",
    "agents",
    "agent-skills",
    "claude"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "patchy": "./dist/bin.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    },
    "./preact/jsx-runtime": {
      "types": "./dist/preact/jsx-runtime.d.ts",
      "import": "./dist/preact/jsx-runtime.js"
    },
    "./preact/jsx-dev-runtime": {
      "types": "./dist/preact/jsx-dev-runtime.d.ts",
      "import": "./dist/preact/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "node ../../scripts/build-patchy-package.mjs",
    "prepack": "node ../../scripts/build-patchy-package.mjs --bundle-only",
    "test": "vitest run --passWithNoTests",
    "typecheck": "effect-tsgo tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/parser": "8.0.8",
    "@babel/types": "8.0.8",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@effect/vitest": "catalog:",
    "@patchy/analytics": "workspace:*",
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/company-database": "workspace:*",
    "@patchy/content-store": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/execution": "workspace:*",
    "@patchy/integrations": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/primitives": "workspace:*",
    "@patchy/runtime": "workspace:*",
    "@patchy/serving": "workspace:*",
    "@types/css-tree": "^3.2.0",
    "@types/papaparse": "5.5.2",
    "@types/semver": "^7.7.1",
    "css-tree": "^3.2.1",
    "effect": "catalog:",
    "ignore": "^7.0.11",
    "papaparse": "5.7.0",
    "parse5": "catalog:",
    "semver": "^7.7.2",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@preact/signals": "2.11.4",
    "@preact/signals-core": "1.14.5",
    "preact": "11.1.0"
  },
  "bundledDependencies": [
    "@electric-sql/pglite",
    "preact",
    "@preact/signals",
    "@preact/signals-core"
  ]
}
