{
  "name": "patchy",
  "version": "0.0.1",
  "description": "The Patchy CLI, typed config, browser client and local dev runtime.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Allison Mahmood",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allisonmahmood/patchy-cloud.git",
    "directory": "packages/patchy"
  },
  "homepage": "https://github.com/allisonmahmood/patchy-cloud#readme",
  "bugs": "https://github.com/allisonmahmood/patchy-cloud/issues",
  "keywords": [
    "html",
    "static-html",
    "patches",
    "preview",
    "publish",
    "cli",
    "agents",
    "agent-skills",
    "claude"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "patchy": "./dist/index.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    },
    "./executeConfig": {
      "types": "./dist/executeConfig.d.ts",
      "import": "./dist/executeConfig.js"
    },
    "./generateClient": {
      "types": "./dist/generateClient.d.ts",
      "import": "./dist/generateClient.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "node ../../scripts/build-patchy-package.mjs",
    "prepack": "node ../../scripts/build-patchy-package.mjs --bundle-only",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/core": "workspace:*",
    "effect": "catalog:",
    "vitest": "^4.1.11"
  }
}
