{
  "name": "patchy",
  "version": "0.0.1",
  "description": "The Patchy CLI, typed config, browser client and local dev runtime.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Allison Mahmood",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allisonmahmood/patchy-cloud.git",
    "directory": "packages/patchy"
  },
  "homepage": "https://github.com/allisonmahmood/patchy-cloud#readme",
  "bugs": "https://github.com/allisonmahmood/patchy-cloud/issues",
  "keywords": [
    "html",
    "static-html",
    "patches",
    "preview",
    "publish",
    "cli",
    "agents",
    "agent-skills",
    "claude"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "patchy": "./dist/index.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "node ../../scripts/build-patchy-package.mjs",
    "prepack": "node ../../scripts/build-patchy-package.mjs --bundle-only",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@effect/vitest": "catalog:",
    "@patchy/api": "workspace:*",
    "@patchy/auth": "workspace:*",
    "@patchy/company-database": "workspace:*",
    "@patchy/content-store": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/integrations": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/primitives": "workspace:*",
    "@patchy/runtime": "workspace:*",
    "@patchy/serving": "workspace:*",
    "@types/css-tree": "^3.2.0",
    "css-tree": "^3.2.1",
    "effect": "catalog:",
    "jsonc-parser": "3.3.1",
    "parse5": "catalog:",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8"
  },
  "bundledDependencies": [
    "@electric-sql/pglite"
  ]
}
