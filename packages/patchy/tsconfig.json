{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "ES2024.Promise", "DOM"],
    "paths": {
      "@patchy/api": ["../../packages/api/src/index.ts"],
      "@patchy/core": ["../../packages/core/src/index.ts"]
    },
    // Public subpaths receive standalone bundled declarations during the build.
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
