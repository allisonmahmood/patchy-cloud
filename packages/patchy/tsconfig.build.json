{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    // Workspace packages resolve to source, so their types emit beside the CLI's to be bundled.
    "customConditions": ["development"],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/config.ts",
    "src/client.ts",
    "src/server.ts",
    "src/csv.ts",
    "src/dev.ts",
    "src/executeConfig.ts",
    "src/preact.ts",
    "src/preact/*.ts"
  ]
}
