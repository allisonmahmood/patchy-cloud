{
  "name": "@patchy/cli",
  "version": "0.0.1",
  "description": "Upload static HTML pages to a Patchy Cloud instance.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Allison Mahmood",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allisonmahmood/patchy-cloud.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/allisonmahmood/patchy-cloud#readme",
  "bugs": "https://github.com/allisonmahmood/patchy-cloud/issues",
  "keywords": [
    "html",
    "static-html",
