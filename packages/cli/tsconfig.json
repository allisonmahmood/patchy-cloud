{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@patchy/api": ["../../packages/api/src/index.ts"],
      "@patchy/core": ["../../packages/core/src/index.ts"]
    },
    // Bundled by esbuild, never emitted: declarations would only trip over
    // Effect's unnameable internal types.
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
