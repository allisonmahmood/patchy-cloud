{
  "name": "@patchy/execution",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The supervised workerd execution engine, local executor and isolated handler inspection.",
  "exports": {
    "./fleet": {
      "development": "./src/fleet.ts",
      "types": "./dist/fleet.d.ts",
      "import": "./dist/fleet.js"
    },
    "./task-provider": {
      "development": "./src/TaskProvider.ts",
      "types": "./dist/TaskProvider.d.ts",
      "import": "./dist/TaskProvider.js"
    },
    "./local-task-provider": {
      "development": "./src/localTaskProvider.ts",
      "types": "./dist/localTaskProvider.d.ts",
      "import": "./dist/localTaskProvider.js"
    },
    "./ecs-task-provider": {
      "development": "./src/ecsTaskProvider.ts",
      "types": "./dist/ecsTaskProvider.d.ts",
      "import": "./dist/ecsTaskProvider.js"
    },
    "./ecs": {
      "development": "./src/ecs.ts",
      "types": "./dist/ecs.d.ts",
      "import": "./dist/ecs.js"
    },
    "./migrations": {
      "development": "./src/migrations.ts",
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    },
    "./engine": {
      "development": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./supervisor": {
      "development": "./src/supervisor.ts",
      "types": "./dist/supervisor.d.ts",
      "import": "./dist/supervisor.js"
    },
    "./management": {
      "development": "./src/management.ts",
      "types": "./dist/management.d.ts",
      "import": "./dist/management.js"
    },
    "./local": {
      "development": "./src/local.ts",
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./inspection": {
      "development": "./src/inspection.ts",
      "types": "./dist/inspection.d.ts",
      "import": "./dist/inspection.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1144.0",
    "@effect/platform-node": "catalog:",
    "@patchy/analytics": "workspace:*",
    "@patchy/api": "workspace:*",
    "@patchy/core": "workspace:*",
    "@patchy/limits": "workspace:*",
    "@patchy/runtime": "workspace:*",
    "@patchy/sql": "workspace:*",
    "effect": "catalog:",
    "es-module-lexer": "3.0.2",
    "esbuild": "0.28.2",
    "workerd": "1.20260924.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "^5.0.3"
  }
}
