{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "artifacts/**", "skills/**", "LICENSE"]
    },
    "patchy#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-patchy-package.mjs",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": ["dist/**", "artifacts/**", "skills/**", "LICENSE"]
    },
    "@patchy/core#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-core-scripts.mjs"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "@patchy/execution#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-execution-loader.mjs"],
      "outputs": ["dist/**"]
    },
    "@patchy/sdk#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/copy-sdk-artifact.mjs"],
      "outputs": ["dist/**", "artifacts/**"]
    },
    "@patchy/docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/limits.md",
        "$TURBO_ROOT$/packages/sdk/skills/patchy-tables/SKILL.md"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@patchy/docs#typecheck": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "//#typecheck:tests": {
      "cache": false
    }
  }
}
