{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "artifacts/**", "skills/**", "LICENSE"]
    },
    "patchy#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-patchy-package.mjs",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/LICENSE"
      ],
      "outputs": ["dist/**", "artifacts/**", "skills/**", "LICENSE"]
    },
    "@patchy/sdk#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/copy-sdk-artifact.mjs"],
      "outputs": ["dist/**", "artifacts/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
