{
  "name": "patchy-mcp",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "bin": {
    "patchy-mcp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/express": "^5.0.6"
  },
  "description": "An independent MCP prototype for Patchy Pages and existing Tool handlers, with per-user authentication.",
  "files": [
    "dist",
    "README.md",
    "SETUP.md"
  ],
  "bundledDependencies": [
    "@modelcontextprotocol/express",
    "@modelcontextprotocol/node",
    "@modelcontextprotocol/server",
    "express",
    "zod"
  ]
