{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup",
      "command": "pnpm install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Start dev",
      "command": "pnpm dev",
      "icon": "play"
    },
    {
      "name": "Stop dev",
      "command": "pnpm dev stop",
      "icon": "configure"
    },
    {
      "name": "Restart dev",
      "command": "pnpm dev stop && pnpm dev",
      "icon": "play"
    },
    {
      "name": "Environment up",
      "command": "pnpm dev up",
      "icon": "play"
    },
    {
      "name": "Demo up",
      "command": "pnpm dev up brightline",
      "icon": "play"
    },
    {
      "name": "Environment down",
      "command": "pnpm dev down",
      "icon": "configure"
    },
    {
      "name": "Check",
      "command": "pnpm check",
      "icon": "test"
    }
  ]
}
